# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/youshop?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youshop
POSTGRES_PORT=5432

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# App
PORT=3000
NODE_ENV="development"
API_PREFIX="api/v1"

# Tax Rate (percentage)
TAX_RATE=20

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
