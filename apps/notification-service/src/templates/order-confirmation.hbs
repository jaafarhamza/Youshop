<html>
  <head>
    <meta charset='utf-8' />
    <title>Order Confirmation</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        line-height: 1.6;
      }
      .container {
        width: 80%;
        margin: 20px auto;
        border: 1px solid #eee;
        padding: 20px;
        border-radius: 10px;
      }
      .header {
        text-align: center;
        border-bottom: 2px solid #f4f4f4;
        padding-bottom: 20px;
      }
      .order-details {
        margin: 20px 0;
      }
      .item-table {
        width: 100%;
        border-collapse: collapse;
      }
      .item-table th,
      .item-table td {
        text-align: left;
        padding: 12px;
        border-bottom: 1px solid #eee;
      }
      .totals {
        margin-top: 20px;
        text-align: right;
      }
      .footer {
        margin-top: 40px;
        font-size: 12px;
        color: #777;
        text-align: center;
      }
      .button {
        background-color: #007bff;
        color: white;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 5px;
        display: inline-block;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Thank you for your order!</h1>
        <p>Order ID: #{{orderId}}</p>
      </div>

      <div class='order-details'>
        <p>Hi {{customerName}},</p>
        <p>We've received your order and are processing it. Here's a summary of
          what you bought:</p>

        <table class='item-table'>
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            {{#each items}}
              <tr>
                <td>{{name}}</td>
                <td>{{quantity}}</td>
                <td>{{currency}} {{price}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class='totals'>
        <p>Subtotal: {{currency}} {{subtotal}}</p>
        <p>Tax: {{currency}} {{tax}}</p>
        <h3>Total: {{currency}} {{total}}</h3>
      </div>

      <div class='footer'>
        <p>&copy; 2026 Youshop. All rights reserved.</p>
        <p>If you have any questions, reply to this email.</p>
        <p style='margin-top: 10px; font-size: 10px;'>
          You received this email because you made a purchase at Youshop.
          <a href='{{unsubscribeUrl}}'>Unsubscribe</a>
          |
          <a href='{{preferencesUrl}}'>Manage Preferences</a>
        </p>
      </div>
    </div>
  </body>
</html>