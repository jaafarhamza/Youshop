<html>
  <head>
    <meta charset='utf-8' />
    <title>Order Cancelled</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        line-height: 1.6;
      }
      .container {
        width: 80%;
        margin: 20px auto;
        border: 1px solid #eee;
        padding: 20px;
        border-radius: 10px;
      }
      .header {
        text-align: center;
        border-bottom: 2px solid #f4f4f4;
        padding-bottom: 20px;
        color: #dc3545;
      }
      .content {
        margin: 20px 0;
      }
      .footer {
        margin-top: 40px;
        font-size: 12px;
        color: #777;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Order Cancelled</h1>
        <p>Order ID: #{{orderId}}</p>
      </div>
      <div class='content'>
        <p>Hi {{customerName}},</p>
        <p>Your order #{{orderId}} has been successfully cancelled.</p>
        <p><strong>Reason:</strong> {{reason}}</p>
        <p>If you were already charged, a refund will be processed within 5-7
          business days.</p>
      </div>
      <div class='footer'>
        <p>&copy; 2026 Youshop. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>